# App
SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-only-replace-me-with-32-chars-min
BETTER_AUTH_URL=http://localhost:3000

# Turso / libSQL (optional locally — seed JSON still powers catalog)
TURSO_DATABASE_URL=file:./data/local.db
TURSO_AUTH_TOKEN=
# Platform API token (org) — manage DBs via API; not the same as TURSO_AUTH_TOKEN
TURSO_API_TOKEN=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated emails that can approve org verification (/staff)
ADMIN_EMAILS=

# Catalog webhooks (outbound + dispatch after deploy)
CATALOG_WEBHOOK_ADMIN_TOKEN=
CATALOG_WEBHOOK_DISPATCH_SECRET=
# GitHub webhook from oss-fund/directory → repository_dispatch
OSS_FUND_GITHUB_WEBHOOK_SECRET=
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPO=nonprofit-resources/website

# Customer.io (news subscribe)
CUSTOMER_IO_SITE_ID=
CUSTOMER_IO_API_KEY=
CUSTOMER_IO_TRACK_API_KEY=

# Resend (transactional + news contacts)
RESEND_API_KEY=
RESEND_FROM=support@updates.nonprofit-resources.org
RESEND_NEWS_AUDIENCE_ID=

# Gemini catalog verify (pnpm catalog:verify / Verify catalog workflow)
# Key: Bitwarden item "nonprofit-resources" (Google Cloud project 54406180065)
# Docs: docs/ENV-VARIABLES.md
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
CATALOG_VERIFY_MAX_AGE_DAYS=30
CATALOG_VERIFY_LIMIT=0
CATALOG_VERIFY_MIN_CONFIDENCE=0.7
# Actions secret only — fine-grained PAT (Contents + Pull requests on this repo).
# See docs/ENV-VARIABLES.md#catalog_verify_github_token
# CATALOG_VERIFY_GITHUB_TOKEN=
